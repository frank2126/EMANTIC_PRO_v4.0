# ═══════════════════════════════════════════════════════════════════════════════
#  EMANTIX PRO — FASE 7 — Environment Variables
#  IMPORTANTE: NO incluir credenciales reales
#  Copiar a .env y llenar con valores reales
# ═══════════════════════════════════════════════════════════════════════════════

# ── FRONTEND ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=EMANTIC Pro v4.0

# ── BACKEND (FastAPI) ───────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── DATABASE (SQL Server) ───────────────────────────────────────────────────
DB_SERVER=sql_server
DB_NAME=EMANTIC_DB
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd  # CAMBIAR EN PRODUCCIÓN
DB_DRIVER=ODBC Driver 17 for SQL Server

# Pool de Conexiones
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800

# ── UPLOAD FILES ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=pdf,xlsx,xls,csv

# ── EMAIL (Opcional) ────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@emantic.com

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_FILE=logs/emantix.log
LOG_LEVEL=INFO

# ── NGINX ───────────────────────────────────────────────────────────────────
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# ── DOCKER ──────────────────────────────────────────────────────────────────
DOCKER_NETWORK=emantic-prod
DOCKER_REGISTRY=your-docker-registry.com

# ── CERTIFICADOS SSL (Producción) ───────────────────────────────────────────
# Usar Let's Encrypt en producción
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ── SEGURIDAD ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://emantic.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,emantic.example.com

# ── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ── MONITORING (Opcional) ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── CLOUDFLARE (Opcional) ───────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

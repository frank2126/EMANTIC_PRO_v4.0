# Copia este archivo como bot/.env y llénalo. El archivo .env NO se sube a Git (está en .gitignore).
# Dirección de inicio de sesión de TransMiTools (la misma que abres en el navegador)
TRANSMITOOLS_URL=https://transmitools.transmilenio.gov.co/authenticate
# Tus datos: el bot los escribe por ti, pero el reCAPTCHA lo marcas tú
TRANSMITOOLS_USUARIO=EM006
TRANSMITOOLS_CLAVE=Emasivo1026*
# Opcionales
# BOT_NAVEGADOR=chrome        # chrome | msedge | chromium (si no tienes Chrome instalado)
# BOT_FORMATO=excel           # excel | csv (solo si el sitio pregunta qué formato bajar)
# BOT_ESPERA_LOGIN_MIN=5      # minutos que espera a que marques el captcha

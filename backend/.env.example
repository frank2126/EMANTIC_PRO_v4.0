# ═══════════════════════════════════════════════════════════════════════════
#  EMANTIC PRO v4.0 — Archivo de Configuración de Entorno
#  Copiar a .env y completar valores reales
# ═══════════════════════════════════════════════════════════════════════════

# ── APLICACIÓN ─────────────────────────────────────────────────────────────
APP_NAME=Emantic Pro API
APP_VERSION=4.0.0
DEBUG=False
ALLOW_DEBUG=false

# ── SEGURIDAD ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://emantic.tudominio.com

# ── BASE DE DATOS ──────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_NAME=EmantixDB
DB_USER=sa
DB_PASSWORD=your-database-password
DB_USE_WINDOWS_AUTH=False
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# ── SMTP (EMAIL) ───────────────────────────────────────────────────────────
# Configuración para recuperación de contraseña
# Para Gmail: Usar "App Password" después de habilitar 2FA
# URL: https://myaccount.google.com/app-passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=your-app-password-not-personal-password
SMTP_FROM=noreply@emantix.com

# ── POLÍTICA DE CONTRASEÑAS ────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_NUMBER=True
PASSWORD_REQUIRE_SPECIAL=False
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=300

# ── ARCHIVOS ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=pdf,xlsx,xls,csv

# ── PAGINACIÓN ─────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── LOGGING ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/emantix.log

# ═══════════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES:
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. SECRET_KEY:
#    Generar con: openssl rand -hex 32
#    Mínimo 32 caracteres
#    CAMBIAR en producción
#
# 2. DB_PASSWORD:
#    Usar contraseña fuerte (16+ caracteres)
#    NO incluir caracteres especiales problemáticos: % $ @ ' "
#
# 3. SMTP_PASSWORD (Gmail):
#    NO es tu contraseña de Gmail normal
#    Generar "App Password" en myaccount.google.com/app-passwords
#    Requiere 2FA habilitado
#
# 4. No commitear este archivo con valores reales al repositorio
#    Usar .gitignore para excluir .env
#
# ═══════════════════════════════════════════════════════════════════════════

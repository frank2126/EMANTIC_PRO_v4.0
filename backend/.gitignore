# ═══════════════════════════════════════════════════════════
#  EMANTIX PRO — .gitignore
#  Archivos y carpetas que NO deben ir a Git
# ═══════════════════════════════════════════════════════════

# Entorno virtual
venv/
venv_new/
env/
ENV/
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/
*.log
*.log.*

# Archivos cargados
uploads/
!uploads/.gitkeep

# Temporal
tmp/
temp/
.tmp/

# Base de datos
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db
desktop.ini
